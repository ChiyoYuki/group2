# Environment variables are read from the process, not automatically from this file.
# SQLite needs no database service; this path is relative to the working directory.
DATABASE_URL=sqlite:///dream_journey.db

# PostgreSQL: start the development service with docker compose up -d.
# DATABASE_URL=postgresql+psycopg://dream_journey:dream_journey_dev@localhost:5432/dream_journey

# Optional: comma-separated Origins used by an independently hosted frontend.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: filesystem root served under /media/.
# MEDIA_ROOT=/path/to/media
